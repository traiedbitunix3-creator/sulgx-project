# =====================================================================
# نمونه Environment Variables — این فایل فقط برای مرجع/اجرای محلی است.
# هرگز مقدار واقعی BOT_TOKEN یا SULGX_ADMIN_PASSWORD را اینجا یا در گیت
# کامیت نکنید. روی Railway همه‌ی این مقادیر را در Project -> Service ->
# Variables تنظیم کنید.
# =====================================================================

# ==========================
# Telegram Bot
# ==========================
BOT_TOKEN=123456:ABC-your-bot-token
BOT_USERNAME=your_bot_username
ADMIN_IDS=111111111,222222222

# کانال‌های عضویت اجباری (chat_id یا @username), جدا با کاما — اختیاری
REQUIRED_CHANNELS=@your_channel1,@your_channel2
REQUIRED_CHANNELS_URLS=https://t.me/your_channel1,https://t.me/your_channel2

# ==========================
# Web App
# ==========================
# روی Railway، بعد از اولین دیپلوی سرویس backend این پروژه، Railway یک
# دامنه‌ی عمومی مثل https://your-bot-backend.up.railway.app به شما
# می‌دهد. WEBAPP_URL باید همان دامنه + /webapp/ باشد (نه دامنه‌ی پنل
# SulgX، که کاملاً یک سرویس/دامنه‌ی جدا است).
WEBAPP_URL=https://your-bot-backend.up.railway.app/webapp/

# ==========================
# Backend
# ==========================
# روی Railway نیازی به تنظیم PORT نیست؛ Railway خودش آن را تزریق می‌کند.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_SECRET_KEY=change-this-to-a-long-random-string

# فقط اگر WebApp را جدا از این بک‌اند هاست می‌کنید لازم است (حالت پیش‌فرض
# این پروژه روی Railway نیاز ندارد چون WebApp از همان دامنه سرو می‌شود):
CORS_ORIGINS=

# حداکثر عمر مجاز initData ارسالی از Telegram WebApp (ثانیه)
TELEGRAM_INIT_DATA_MAX_AGE=86400

# ==========================
# Database
# ==========================
# روی Railway: یک پلاگین PostgreSQL به این سرویس وصل کنید؛ Railway به‌طور
# خودکار DATABASE_URL را ست می‌کند و نیازی به دست‌کاری آن نیست.
# برای اجرای محلی می‌توانید این خط را کامنت بگذارید تا از SQLite موقت
# استفاده شود، یا یک DATABASE_URL محلی پستگرس بدهید:
# DATABASE_URL=postgresql://user:pass@localhost:5432/sulgx_bot

# ==========================
# SulgX Panel Connector (پنل واقعی SulgX شما - از قبل روی Railway اجراست)
# ==========================
# توجه: این همان دامنه‌ی سرویس panel شماست (بدون /panel در انتها):
SULGX_BASE_URL=https://web-production-c666b.up.railway.app
SULGX_ADMIN_PASSWORD=your-panel-admin-password
SULGX_VERIFY_SSL=true
SULGX_REQUEST_TIMEOUT=15

# نام کلید لینک VLESS در پاسخ POST /api/links پنل شما. پیش‌فرض "link" است؛
# اگر با DevTools > Network چک کردید و پنل شما کلید دیگری برمی‌گرداند
# (مثلاً vless_link)، همین‌جا override کنید:
# SULGX_LINK_FIELD=link

# مسیرهای API پنل SulgX — طبق مستندات این پروژه ثابت‌اند و نیازی به تغییر
# ندارند؛ فقط در صورت اختلاف با پنل واقعی خودتان override کنید:
# SULGX_PATH_LOGIN=/api/login
# SULGX_PATH_LOGOUT=/api/logout
# SULGX_PATH_ME=/api/me
# SULGX_PATH_LINKS=/api/links
# SULGX_PATH_LINK_DETAIL=/api/links/{uid}
# SULGX_PATH_LINK_NEW_UUID=/api/links/{uid}/new-uuid

# ==========================
# قوانین کانفیگ رایگان
# ==========================
MIN_VOLUME_GB=1
MAX_VOLUME_GB=55
ALLOWED_VALIDITY_DAYS=7,15,30
ALLOWED_MAX_CONNECTIONS=1,2,3

LOG_LEVEL=INFO
